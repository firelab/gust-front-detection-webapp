# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# NFGDA Service
MAX_CONCURRENT_JOBS=2               # Max number of jobs to run at once
MAX_NO_DATA_POLLS=10                # Polls radar S3 bucket this many times before giving up
FILE_EXPIRATION_TIME=1440           # 24 hours (minutes)
AUTO_REFRESH_POLL_INTERVAL=120      # Seconds between S3 checks for auto-refreshed stations
ALGO_BASE_TIMEOUT_SECONDS=300       # Baseline NFGDA algorithm timeout
ALGO_TIMEOUT_MINUTE_BUFF=20         # Extra seconds per minute tacked onto algorithm timeout


# Backend 
MAX_JOB_DURATION=180                # Maximum total duration of job timebox (minutes, default is 3 hours)
STATION_JOB_COOLDOWN_MINUTES=15     # Min minutes before a new job can be submitted for the same station
MAX_AUTO_REFRESH_DURATION=10080    # 1 Week (minutes), max time a station can be set to auto-refresh
